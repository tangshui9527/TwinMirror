<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <!-- Connect Screen -->
    <LinearLayout
        android:id="@+id/connectLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="远程投屏控制"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="输入目标手机的 IP:端口"
            android:textColor="#aaaaaa"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="例如 192.168.31.17:5555"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="#16213e"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="text"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="连接"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#0f3460"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="就绪"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

    <!-- Video Screen -->
    <LinearLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Full-area video stage: video centered, nav overlaid at the bottom -->
        <FrameLayout
            android:id="@+id/videoArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000">

            <com.example.remotescreen.AspectRatioFrameLayout
                android:id="@+id/videoFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="top">

                <SurfaceView
                    android:id="@+id/surfaceView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

            </com.example.remotescreen.AspectRatioFrameLayout>

            <TextView
                android:id="@+id/tvVideoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#dddddd"
                android:textSize="16sp"
                android:visibility="gone"/>

            <!-- Translucent nav overlay: floats over the video, auto-hides -->
            <LinearLayout
                android:id="@+id/navOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:padding="6dp"
                android:background="#66000000">

                <Button
                    android:id="@+id/btnRecent"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Recent"
                    android:textSize="14sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#0f3460"/>

                <Button
                    android:id="@+id/btnHome"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Home"
                    android:textSize="14sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#0f3460"/>

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Back"
                    android:textSize="14sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#0f3460"/>

                <Button
                    android:id="@+id/btnDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Close"
                    android:textSize="14sp"
                    android:backgroundTint="#e94560"/>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
